---
---
{% assign proceedings = 'inproceedings,incollection' | split: ',' %}
{% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}

{% assign venue = '' %}
{% if entry.type == 'article' and entry.journal %}
  {% assign venue = entry.journal %}
{% elsif proceedings contains entry.type and entry.booktitle %}
  {% assign venue = entry.booktitle %}
{% elsif thesis contains entry.type and entry.school %}
  {% assign venue = entry.school %}
{% elsif entry.booktitle %}
  {% assign venue = entry.booktitle %}
{% elsif entry.publisher %}
  {% assign venue = entry.publisher %}
{% elsif entry.journal %}
  {% assign venue = entry.journal %}
{% endif %}

{% assign venue_text = venue | strip_html | strip %}
{% assign venue_text_upcase = venue_text | upcase %}
{% assign pages_text = entry.pages | replace: '--', '&ndash;' | strip %}
{% assign is_proceeding = false %}
{% if proceedings contains entry.type %}
  {% assign is_proceeding = true %}
{% endif %}
{% assign proceedings_venue_text = venue_text %}
{% if is_proceeding and venue_text contains ' - ' %}
  {% assign proceedings_venue_parts = venue_text | split: ' - ' %}
  {% assign proceedings_venue_first = proceedings_venue_parts | first | strip %}
  {% assign proceedings_venue_last = proceedings_venue_parts | last | strip %}
  {% assign proceedings_venue_first_downcase = proceedings_venue_first | downcase %}
  {% if proceedings_venue_first_downcase contains 'proceedings of' %}
    {% assign proceedings_venue_text = proceedings_venue_first %}
  {% else %}
    {% assign proceedings_venue_text = proceedings_venue_last %}
  {% endif %}
{% endif %}
{% assign proceedings_venue_text = proceedings_venue_text | regex_replace: '\s*\([A-Z][A-Za-z0-9 .&-]*\)\s*$', '' | strip %}
{% assign proceedings_venue_text_downcase = proceedings_venue_text | downcase %}
{% assign venue_badge = entry.abbr %}
{% if venue_badge == blank %}
  {% if venue_text_upcase contains 'ICASSP' or venue_text_upcase contains 'ACOUSTICS, SPEECH' %}
    {% assign venue_badge = 'ICASSP' %}
  {% elsif venue_text_upcase contains 'ICME' or venue_text_upcase contains 'MULTIMEDIA AND EXPO' %}
    {% assign venue_badge = 'ICME' %}
  {% elsif venue_text_upcase contains 'ISMIR' or venue_text_upcase contains 'MUSIC INFORMATION RETRIEVAL' %}
    {% assign venue_badge = 'ISMIR' %}
  {% elsif venue_text_upcase contains 'APSIPA' or venue_text_upcase contains 'ASIA-PACIFIC SIGNAL' %}
    {% assign venue_badge = 'APSIPA' %}
  {% elsif venue_text_upcase contains 'DIGITAL LIBRARIES FOR MUSICOLOGY' %}
    {% assign venue_badge = 'DLfM' %}
  {% elsif venue_text_upcase contains 'MUSIC ENCODING' %}
    {% assign venue_badge = 'MEC' %}
  {% elsif thesis contains entry.type %}
    {% assign venue_badge = 'PhD' %}
  {% elsif venue_text_upcase contains 'ARXIV' %}
    {% assign venue_badge = 'arXiv' %}
  {% elsif entry.journal %}
    {% assign venue_badge = entry.journal %}
  {% elsif entry.publisher %}
    {% assign venue_badge = entry.publisher %}
  {% else %}
    {% assign venue_badge = 'Publication' %}
  {% endif %}
{% endif %}

{% assign note_text = entry.note | strip %}
{% assign note_summary = '' %}
{% assign public_note = '' %}
{% if note_text contains 'Summary:' %}
  {% assign note_parts = note_text | split: 'Summary:' %}
  {% assign public_note = note_parts | first | strip %}
  {% assign note_summary = note_parts | last | strip %}
{% elsif note_text != blank %}
  {% assign public_note = note_text %}
{% endif %}

{% assign title_url = '' %}
{% if entry.doi %}
  {% assign title_url = entry.doi | prepend: 'https://doi.org/' %}
{% elsif entry.url %}
  {% assign title_url = entry.url %}
{% elsif entry.html %}
  {% if entry.html contains '://' %}
    {% assign title_url = entry.html %}
  {% else %}
    {% assign title_url = entry.html | prepend: '/assets/html/' | relative_url %}
  {% endif %}
{% elsif entry.pdf %}
  {% if entry.pdf contains '://' %}
    {% assign title_url = entry.pdf %}
  {% else %}
    {% assign title_url = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
  {% endif %}
{% elsif entry.arxiv %}
  {% assign title_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
{% endif %}

{% assign has_abstract = false %}
{% if entry.abstract or note_summary != blank %}
  {% assign has_abstract = true %}
{% endif %}

<div class="pub-entry" id="{{ entry.key }}">
  <span class="pub-venue">
    {{- venue_badge -}}
    {%- if entry.year %} {{ entry.year }}{% endif -%}
  </span>

  <span class="pub-citation">
    <span class="author">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^¹]', '' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^¹]+)', '<sup>\1</sup>' -%}
        {% if site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {% if forloop.first == false -%}
            {%- if forloop.length > 2 %}, {% elsif forloop.length == 2 %} {% endif %}
          {%- endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
        {% endif %}
        {%- if author_is_self -%}
          <em>
            {{- author.first }}
            {{ author_last_html -}}
          </em>
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{ coauthor_url }}">
              {{- author.first }}
              {{ author_last_html -}}
            </a>
          {%- else -%}
            {{- author.first }}
            {{ author_last_html -}}
          {% endif %}
        {%- endif -%}
      {% endfor %}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}

      {%- assign more_authors_hide = more_authors | append: ' more author' -%}
      {% if more_authors > 0 %}
        {%- if more_authors > 1 -%}
          {% assign more_authors_hide = more_authors_hide | append: 's' %}
        {%- endif -%}
        {% assign more_authors_show = '' %}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' | append: author.last %}
          {% unless forloop.last %}
            {% assign more_authors_show = more_authors_show | append: ', ' %}
          {% endunless %}
        {%- endfor -%}
        {%- assign more_authors_show = more_authors_show | regex_replace: '([*∗†‡§¶‖&^¹]+)', '<sup>\1</sup>' -%}
        , and
        <span
          class="more-authors"
          title="click to view {{ more_authors_hide }}"
          onclick="
              var element = $(this);
              element.attr('title', '');
              var more_authors_text = element.text() == '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
              var cursorPosition = 0;
              var textAdder = setInterval(function(){
                element.html(more_authors_text.substring(0, cursorPosition + 1));
                if (++cursorPosition == more_authors_text.length){
                  clearInterval(textAdder);
                }
            }, '{{ site.more_authors_animation_delay }}');
          "
        >
          {{- more_authors_hide -}}
        </span>
      {% endif %}
      {%- if entry.annotation %}
        <i
          class="fa-solid fa-circle-info ml-1"
          data-toggle="popover"
          data-placement="top"
          data-html="true"
          data-content="{{ entry.annotation | escape }}"
        >
        </i>
      {%- endif -%}.
    </span>

    {% if title_url != blank %}
      <a class="pub-title" href="{{ title_url }}">&ldquo;{{ entry.title }}.&rdquo;</a>
    {% else %}
      <span class="pub-title">&ldquo;{{ entry.title }}.&rdquo;</span>
    {% endif %}

    {% if is_proceeding and proceedings_venue_text != blank %}
      <span class="pub-periodical">
        In
        {% if proceedings_venue_text_downcase contains 'proceedings of' %}
          {{ proceedings_venue_text -}}
        {% else %}
          Proceedings of the {{ proceedings_venue_text -}}
        {% endif -%}
        {%- if pages_text != blank %}, {{ pages_text }}{% endif -%}
        {%- if entry.year %}. {{ entry.year }}{% endif -%}.
      </span>
    {% elsif entry.type == 'article' and venue_text != blank %}
      <span class="pub-periodical">
        <em>{{ venue_text }}</em>
        {%- if entry.volume %} {{ entry.volume }}{% endif -%}
        {%- if entry.number %}, no. {{ entry.number }}{% endif -%}
        {%- if entry.year %} ({{ entry.year }}){% endif -%}
        {%- if pages_text != blank %}: {{ pages_text }}{% endif -%}.
      </span>
    {% elsif thesis contains entry.type %}
      <span class="pub-periodical">
        {%- if entry.type == 'phdthesis' -%}
          PhD diss.
        {%- else -%}
          Thesis
        {%- endif -%}
        {%- if entry.school %}, {{ entry.school }}{% endif -%}
        {%- if entry.year %}, {{ entry.year }}{% endif -%}.
      </span>
    {% elsif entry.type == 'misc' %}
      <span class="pub-periodical">
        {%- if entry.publisher %}{{ entry.publisher }}{% else %}Publication{% endif -%}
        {%- if entry.arxiv %} preprint arXiv:{{ entry.arxiv }}{% endif -%}
        {%- if entry.year %}, {{ entry.year }}{% endif -%}
        {%- if pages_text != blank %}, {{ pages_text }}{% endif -%}.
      </span>
    {% elsif venue_text != blank or entry.year %}
      <span class="pub-periodical">
        {% if venue_text != blank %}
          {{ venue_text }}
          {%- if entry.year %}, {% endif -%}
        {% endif %}
        {{- entry.year -}}.
      </span>
    {% endif %}

    {% if public_note != blank %}
      <span class="pub-note">({{ public_note | markdownify | remove: '<p>' | remove: '</p>' | strip }})</span>
    {% endif %}
  </span>

  <span class="links pub-links">
    {% if entry.award %}
      <a class="award pub-link" role="button">
        {%- if entry.award_name %}{{ entry.award_name }}{% else %}Award{% endif -%}
      </a>
    {% endif %}
    {% if has_abstract %}
      <a class="abstract pub-link" role="button">Abs</a>
    {% endif %}
    {% if entry.arxiv %}
      <a href="https://arxiv.org/abs/{{ entry.arxiv }}" class="pub-link" role="button">arXiv</a>
    {% endif %}
    {% if entry.bibtex_show %}
      <a class="bibtex pub-link" role="button">Bib</a>
    {% endif %}
    {% if entry.html %}
      {% if entry.html contains '://' %}
        <a href="{{ entry.html }}" class="pub-link" role="button">HTML</a>
      {% else %}
        <a href="{{ entry.html | prepend: '/assets/html/' | relative_url }}" class="pub-link" role="button">HTML</a>
      {% endif %}
    {% endif %}
    {% if entry.pdf %}
      {% if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}" class="pub-link" role="button">PDF</a>
      {% else %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="pub-link" role="button">PDF</a>
      {% endif %}
    {% endif %}
    {% if entry.supp %}
      {% if entry.supp contains '://' %}
        <a href="{{ entry.supp }}" class="pub-link" role="button">Supp</a>
      {% else %}
        <a href="{{ entry.supp | prepend: '/assets/pdf/' | relative_url }}" class="pub-link" role="button">Supp</a>
      {% endif %}
    {% endif %}
    {% if entry.video and site.enable_video_embedding %}
      <a class="abstract pub-link" role="button">Video</a>
    {% elsif entry.video %}
      <a href="{{ entry.video }}" class="pub-link" role="button">Video</a>
    {% endif %}
    {% if entry.blog %}
      <a href="{{ entry.blog }}" class="pub-link" role="button">Blog</a>
    {% endif %}
    {% if entry.code %}
      <a href="{{ entry.code }}" class="pub-link" role="button">Code</a>
    {% endif %}
    {% if entry.poster %}
      {% if entry.poster contains '://' %}
        <a href="{{ entry.poster }}" class="pub-link" role="button">Poster</a>
      {% else %}
        <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}" class="pub-link" role="button">Poster</a>
      {% endif %}
    {% endif %}
    {% if entry.slides %}
      {% if entry.slides contains '://' %}
        <a href="{{ entry.slides }}" class="pub-link" role="button">Slides</a>
      {% else %}
        <a href="{{ entry.slides | prepend: '/assets/pdf/' | relative_url }}" class="pub-link" role="button">Slides</a>
      {% endif %}
    {% endif %}
    {% if entry.website %}
      <a href="{{ entry.website }}" class="pub-link" role="button">Website</a>
    {% endif %}
  </span>

  {% if site.enable_publication_badges %}
    {% assign entry_has_altmetric_badge = false %}
    {% if entry.altmetric and entry.altmetric != 'false' %}
      {% assign entry_has_altmetric_badge = true %}
    {% endif %}

    {% assign entry_has_dimensions_badge = false %}
    {% if entry.dimensions and entry.dimensions != 'false' %}
      {% assign entry_has_dimensions_badge = true %}
    {% endif %}

    {% assign entry_has_google_scholar_badge = false %}
    {% if entry.google_scholar_id %}
      {% assign entry_has_google_scholar_badge = true %}
    {% endif %}

    {% assign entry_has_inspirehep_badge = false %}
    {% if entry.inspirehep_id %}
      {% assign entry_has_inspirehep_badge = true %}
    {% endif %}
    {% if entry_has_altmetric_badge or entry_has_dimensions_badge or entry_has_google_scholar_badge or entry_has_inspirehep_badge %}
      <span class="badges">
        {% if site.enable_publication_badges.altmetric and entry_has_altmetric_badge %}
          <span
            class="altmetric-embed"
            data-badge-type="2"
            data-badge-popover="right"
            {% if entry.altmetric != blank and entry.altmetric != 'true' %}
              data-altmetric-id="{{ entry.altmetric }}"
            {% elsif entry.arxiv %}
              data-arxiv-id="{{ entry.arxiv }}"
            {% elsif entry.eprint %}
              data-arxiv-id="{{ entry.eprint }}"
            {% elsif entry.doi %}
              data-doi="{{ entry.doi }}"
            {% elsif entry.pmid %}
              data-pmid="{{ entry.pmid }}"
            {% elsif entry.isbn %}
              data-isbn="{{ entry.isbn }}"
            {% endif %}
          ></span>
        {% endif %}
        {% if site.enable_publication_badges.dimensions and entry_has_dimensions_badge %}
          <span
            class="__dimensions_badge_embed__"
            {% if entry.dimensions != blank and entry.dimensions != 'true' %}
              data-id="{{ entry.dimensions }}"
            {% elsif entry.doi %}
              data-doi="{{ entry.doi }}"
            {% else %}
              data-pmid="{{ entry.pmid }}"
            {% endif %}
            data-style="small_rectangle"
            data-legend="hover-right"
          ></span>
        {% endif %}
        {% if site.enable_publication_badges.google_scholar and entry_has_google_scholar_badge %}
          <a
            href="https://scholar.google.com/citations?view_op=view_citation&hl=en&user={{ site.data.socials.scholar_userid }}&citation_for_view={{ site.data.socials.scholar_userid }}:{{ entry.google_scholar_id }}"
            aria-label="Google Scholar link"
            role="button"
          >
            <img
              src="https://img.shields.io/badge/scholar-{% google_scholar_citations site.data.socials.scholar_userid entry.google_scholar_id %}-4285F4?logo=googlescholar&labelColor=beige"
              alt="{% google_scholar_citations site.data.socials.scholar_userid entry.google_scholar_id %} Google Scholar citations"
            >
          </a>
        {% endif %}
        {% if site.enable_publication_badges.inspirehep and entry_has_inspirehep_badge %}
          <a
            href="https://inspirehep.net/literature/{{ entry.inspirehep_id }}"
            aria-label="Inspirehep link"
            role="button"
          >
            <img
              src="https://img.shields.io/badge/inspire-{% inspirehep_citations entry.inspirehep_id %}-001628?logo=inspire&logoColor=001628&labelColor=beige"
              alt="{% inspirehep_citations entry.inspirehep_id %} InspireHEP citations"
            >
          </a>
        {% endif %}
      </span>
    {% endif %}
  {% endif %}

  {% if entry.award %}
    <div class="award hidden d-print-inline">
      <p>{{ entry.award | markdownify }}</p>
    </div>
  {% endif %}

  {% if has_abstract %}
    <div class="abstract hidden">
      {% if entry.abstract %}
        <p>{{ entry.abstract }}</p>
      {% else %}
        <p>{{ note_summary }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if entry.bibtex_show %}
    <div class="bibtex hidden">
      {% highlight bibtex %}
      {{- entry.bibtex | hideCustomBibtex -}}
      {% endhighlight %}
    </div>
  {% endif %}

  {% if entry.video and site.enable_video_embedding %}
    <div class="abstract hidden">
      <div style="text-align: center;">{% include video.liquid path=entry.video class="img-fluid rounded z-depth-1" controls=true %}</div>
    </div>
  {% endif %}
</div>
